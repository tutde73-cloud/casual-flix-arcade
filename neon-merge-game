<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Neon Fruit Physics Merge</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Matter.js Physics Engine -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/matter-js/0.19.0/matter.min.js"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;800;900&display=swap');

    * {
      user-select: none;
      -webkit-user-select: none;
      touch-action: manipulation;
      box-sizing: border-box;
      font-family: 'Outfit', sans-serif;
    }

    body {
      background: radial-gradient(circle at center, #18192a 0%, #0b0c15 100%);
      color: #ffffff;
      overflow: hidden;
    }

    .glass-panel {
      background: rgba(22, 25, 43, 0.75);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.12);
      box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.5);
    }

    .glass-btn {
      background: linear-gradient(135deg, rgba(6, 182, 212, 0.25) 0%, rgba(236, 72, 153, 0.25) 100%);
      border: 1px solid rgba(255, 255, 255, 0.25);
      transition: all 0.2s ease-in-out;
    }

    .glass-btn:hover {
      background: linear-gradient(135deg, rgba(6, 182, 212, 0.45) 0%, rgba(236, 72, 153, 0.45) 100%);
      border-color: rgba(255, 255, 255, 0.5);
      transform: translateY(-2px);
      box-shadow: 0 0 15px rgba(6, 182, 212, 0.5);
    }

    .glass-btn:active {
      transform: translateY(1px);
    }

    .neon-glow-cyan {
      box-shadow: 0 0 15px rgba(6, 182, 212, 0.6);
    }

    .neon-text-cyan {
      text-shadow: 0 0 10px rgba(6, 182, 212, 0.8), 0 0 20px rgba(6, 182, 212, 0.4);
    }
    
    .neon-text-gold {
      text-shadow: 0 0 10px rgba(234, 179, 8, 0.8), 0 0 20px rgba(234, 179, 8, 0.4);
    }

    /* Danger Line Pulsing Animation */
    @keyframes dangerPulse {
      0%, 100% { opacity: 0.3; }
      50% { opacity: 1; }
    }

    .danger-line-active {
      animation: dangerPulse 0.5s infinite ease-in-out;
    }

    canvas {
      display: block;
    }
  </style>
</head>
<body class="h-screen w-screen flex flex-col justify-between items-center p-2 sm:p-4 relative">

  <!-- HUD Header -->
  <header class="w-full max-w-lg glass-panel rounded-2xl p-3 flex justify-between items-center z-10 shadow-lg">
    <!-- Score & High Score -->
    <div class="flex items-center space-x-4">
      <div>
        <p class="text-[10px] uppercase tracking-wider text-slate-400 font-semibold">Score</p>
        <p id="scoreEl" class="text-2xl font-black text-cyan-400 neon-text-cyan">0</p>
      </div>
      <div class="h-8 w-px bg-white/10"></div>
      <div>
        <p class="text-[10px] uppercase tracking-wider text-slate-400 font-semibold">Best</p>
        <p id="highScoreEl" class="text-xl font-black text-amber-400 neon-text-gold">0</p>
      </div>
    </div>

    <!-- Next Orb Preview & Pause Button -->
    <div class="flex items-center space-x-3">
      <div class="flex items-center space-x-2 bg-black/40 px-3 py-1.5 rounded-xl border border-white/10">
        <span class="text-xs text-slate-400 font-bold uppercase tracking-wider">Next:</span>
        <div id="nextOrbContainer" class="w-7 h-7 flex items-center justify-center relative">
          <!-- Next Orb SVG dynamically rendered here -->
        </div>
      </div>

      <button id="pauseBtn" class="p-2 rounded-xl glass-btn text-white text-base focus:outline-none">
        ⏸️
      </button>
    </div>
  </header>

  <!-- Main Canvas Container -->
  <main id="canvasContainer" class="relative w-full max-w-lg flex-1 my-2 sm:my-3 rounded-3xl overflow-hidden glass-panel border border-white/10 flex justify-center items-center">
    <canvas id="gameCanvas"></canvas>

    <!-- Danger Warning Banner -->
    <div id="dangerBanner" class="absolute top-12 left-1/2 -translate-x-1/2 px-4 py-1.5 rounded-full bg-rose-500/80 backdrop-blur-md border border-rose-400/50 text-white font-bold text-xs uppercase tracking-widest hidden z-10 animate-bounce shadow-[0_0_15px_rgba(244,63,94,0.6)]">
      ⚠️ Danger! Overflowing: <span id="dangerTimer">3.0</span>s
    </div>

    <!-- Start Overlay Screen -->
    <div id="startOverlay" class="absolute inset-0 flex flex-col justify-center items-center p-6 text-center z-20 bg-slate-950/80 backdrop-blur-md">
      <h1 class="text-3xl sm:text-5xl font-black mb-2 text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-pink-500 to-amber-400 tracking-tight">
        NEON MERGE
      </h1>
      <p class="text-slate-300 text-xs sm:text-sm max-w-xs mb-6 leading-relaxed">
        Drop & merge matching neon spheres! Evolve them into the ultimate <span class="text-amber-400 font-bold">Neon Sun</span>.
      </p>

      <!-- Orb Tier Preview List -->
      <div class="flex items-center justify-center space-x-1 mb-6 bg-black/30 p-2 rounded-2xl border border-white/10">
        <div class="w-4 h-4 rounded-full bg-cyan-400 shadow-[0_0_6px_#06b6d4]"></div>
        <span class="text-slate-500 text-xs">➔</span>
        <div class="w-5 h-5 rounded-full bg-pink-500 shadow-[0_0_6px_#ec4899]"></div>
        <span class="text-slate-500 text-xs">➔</span>
        <div class="w-6 h-6 rounded-full bg-lime-400 shadow-[0_0_6px_#a3e635]"></div>
        <span class="text-slate-500 text-xs">➔</span>
        <div class="w-7 h-7 rounded-full bg-amber-400 shadow-[0_0_6px_#f59e0b]"></div>
        <span class="text-slate-500 text-xs">➔ ☀️</span>
      </div>

      <button id="startBtn" class="px-8 py-3.5 rounded-2xl glass-btn font-extrabold text-base text-white tracking-wider uppercase">
        Start Game
      </button>

      <div class="mt-6 flex items-center space-x-3 text-xs text-slate-400">
        <span>🖱️ Drag & Click</span>
        <span>•</span>
        <span>👆 Touch & Release</span>
      </div>
    </div>

    <!-- Pause Overlay Screen -->
    <div id="pauseOverlay" class="absolute inset-0 flex flex-col justify-center items-center p-6 text-center z-20 hidden bg-black/70 backdrop-blur-md">
      <h2 class="text-3xl font-black mb-6 text-cyan-400 neon-text-cyan">GAME PAUSED</h2>
      <button id="resumeBtn" class="px-8 py-3.5 rounded-2xl glass-btn font-extrabold text-base text-white uppercase tracking-wider mb-3">
        Resume Game
      </button>
      <button id="quitBtn" class="px-6 py-2.5 rounded-xl bg-slate-800/80 hover:bg-slate-700/80 text-xs text-slate-300 uppercase tracking-wider font-semibold border border-white/10">
        Quit to Menu
      </button>
    </div>

    <!-- Game Over Overlay Screen -->
    <div id="gameOverOverlay" class="absolute inset-0 flex flex-col justify-center items-center p-6 text-center z-20 hidden bg-black/80 backdrop-blur-md">
      <h2 class="text-4xl font-black mb-1 text-rose-500 drop-shadow-[0_0_15px_rgba(244,63,94,0.6)]">
        GAME OVER
      </h2>
      <p id="newHighScoreTag" class="text-amber-400 text-xs font-bold tracking-widest uppercase mb-4 hidden neon-text-gold">
        🏆 NEW HIGH SCORE! 🏆
      </p>

      <div class="glass-panel rounded-2xl p-4 w-60 mb-6 space-y-2 border border-white/10">
        <div class="flex justify-between items-center text-sm">
          <span class="text-slate-400">Score:</span>
          <span id="finalScoreEl" class="text-xl font-bold text-cyan-400">0</span>
        </div>
        <div class="flex justify-between items-center text-sm">
          <span class="text-slate-400">Best:</span>
          <span id="bestScoreEl" class="text-xl font-bold text-amber-400">0</span>
        </div>
      </div>

      <button id="restartBtn" class="px-8 py-3.5 rounded-2xl glass-btn font-extrabold text-base text-white uppercase tracking-wider">
        Play Again
      </button>
    </div>
  </main>

  <script>
    // --- Synthesized Audio Engine (Web Audio API) ---
    class SoundEngine {
      constructor() {
        this.ctx = null;
      }

      init() {
        if (!this.ctx) {
          const AudioCtx = window.AudioContext || window.webkitAudioContext;
          this.ctx = new AudioCtx();
        }
        if (this.ctx.state === 'suspended') {
          this.ctx.resume();
        }
      }

      playDrop() {
        if (!this.ctx) return;
        const now = this.ctx.currentTime;
        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();

        osc.type = 'sine';
        osc.frequency.setValueAtTime(320, now);
        osc.frequency.exponentialRampToValueAtTime(120, now + 0.12);

        gain.gain.setValueAtTime(0.25, now);
        gain.gain.exponentialRampToValueAtTime(0.01, now + 0.12);

        osc.connect(gain);
        gain.connect(this.ctx.destination);

        osc.start(now);
        osc.stop(now + 0.12);
      }

      playMerge(tier) {
        if (!this.ctx) return;
        const now = this.ctx.currentTime;
        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();

        const baseFreq = 400 + (tier * 70);
        osc.type = 'triangle';
        osc.frequency.setValueAtTime(baseFreq, now);
        osc.frequency.exponentialRampToValueAtTime(baseFreq * 1.5, now + 0.15);

        gain.gain.setValueAtTime(0.35, now);
        gain.gain.exponentialRampToValueAtTime(0.01, now + 0.18);

        osc.connect(gain);
        gain.connect(this.ctx.destination);

        osc.start(now);
        osc.stop(now + 0.18);
      }

      playGameOver() {
        if (!this.ctx) return;
        const now = this.ctx.currentTime;
        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();

        osc.type = 'sawtooth';
        osc.frequency.setValueAtTime(220, now);
        osc.frequency.exponentialRampToValueAtTime(60, now + 0.6);

        gain.gain.setValueAtTime(0.4, now);
        gain.gain.exponentialRampToValueAtTime(0.01, now + 0.6);

        osc.connect(gain);
        gain.connect(this.ctx.destination);

        osc.start(now);
        osc.stop(now + 0.6);
      }
    }

    const sound = new SoundEngine();

    // --- Tier Definitions for Neon Orbs ---
    const ORB_TIERS = [
      { tier: 0, radius: 16, color: '#06b6d4', glow: '#0891b2', name: 'Cyan Mini', score: 10 },
      { tier: 1, radius: 24, color: '#ec4899', glow: '#db2777', name: 'Pink Flare', score: 25 },
      { tier: 2, radius: 34, color: '#a3e635', glow: '#65a30d', name: 'Lime Pulse', score: 45 },
      { tier: 3, radius: 46, color: '#f59e0b', glow: '#d97706', name: 'Gold Spark', score: 70 },
      { tier: 4, radius: 60, color: '#8b5cf6', glow: '#7c3aed', name: 'Violet Nova', score: 105 },
      { tier: 5, radius: 76, color: '#3b82f6', glow: '#2563eb', name: 'Blue Giant', score: 150 },
      { tier: 6, radius: 94, color: '#f43f5e', glow: '#e11d48', name: 'Crimson Core', score: 210 },
      { tier: 7, radius: 114, color: '#10b981', glow: '#059669', name: 'Emerald Star', score: 280 },
      { tier: 8, radius: 136, color: '#f97316', glow: '#ea580c', name: 'Neon Sun', score: 380 }
    ];

    // --- Particle Explosions ---
    class Particle {
      constructor(x, y, color) {
        this.x = x;
        this.y = y;
        this.color = color;
        this.radius = Math.random() * 4 + 2;
        this.vx = (Math.random() - 0.5) * 7;
        this.vy = (Math.random() - 0.5) * 7;
        this.alpha = 1;
        this.decay = Math.random() * 0.03 + 0.02;
      }

      update() {
        this.x += this.vx;
        this.y += this.vy;
        this.alpha -= this.decay;
      }

      draw(ctx) {
        ctx.save();
        ctx.globalAlpha = Math.max(0, this.alpha);
        ctx.beginPath();
        ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);
        ctx.fillStyle = this.color;
        ctx.shadowBlur = 10;
        ctx.shadowColor = this.color;
        ctx.fill();
        ctx.restore();
      }
    }

    // --- Game Engine Variables ---
    const canvas = document.getElementById('gameCanvas');
    const ctx = canvas.getContext('2d');
    const canvasContainer = document.getElementById('canvasContainer');

    // UI Elements
    const scoreEl = document.getElementById('scoreEl');
    const highScoreEl = document.getElementById('highScoreEl');
    const nextOrbContainer = document.getElementById('nextOrbContainer');
    const dangerBanner = document.getElementById('dangerBanner');
    const dangerTimerEl = document.getElementById('dangerTimer');

    const startOverlay = document.getElementById('startOverlay');
    const pauseOverlay = document.getElementById('pauseOverlay');
    const gameOverOverlay = document.getElementById('gameOverOverlay');
    const newHighScoreTag = document.getElementById('newHighScoreTag');

    const startBtn = document.getElementById('startBtn');
    const pauseBtn = document.getElementById('pauseBtn');
    const resumeBtn = document.getElementById('resumeBtn');
    const quitBtn = document.getElementById('quitBtn');
    const restartBtn = document.getElementById('restartBtn');

    const finalScoreEl = document.getElementById('finalScoreEl');
    const bestScoreEl = document.getElementById('bestScoreEl');

    // Matter.js Aliases
    const { Engine, World, Bodies, Body, Events } = Matter;

    let engine, world;
    let particles = [];
    let gameState = 'START'; // START, PLAYING, PAUSED, GAMEOVER
    let score = 0;
    let highScore = parseInt(localStorage.getItem('neon_merge_highscore')) || 0;

    // Drop Control State
    let aimX = 0;
    let currentSpawnTier = 0;
    let nextSpawnTier = 0;
    let canDrop = true;
    let dropCooldownTimer = null;

    // Danger Zone Tracking
    const DANGER_LIMIT_TIME = 3.0; // Seconds
    let dangerTimer = DANGER_LIMIT_TIME;
    let isDangerActive = false;
    let dangerY = 90; // Y position of danger line from top

    // --- Layout & Canvas Setup ---
    function resizeCanvas() {
      const rect = canvasContainer.getBoundingClientRect();
      canvas.width = rect.width;
      canvas.height = rect.height;
      aimX = canvas.width / 2;
      dangerY = 85;

      if (engine && world) {
        updateContainerBoundaries();
      }
    }

    let ground, leftWall, rightWall;

    function updateContainerBoundaries() {
      const thickness = 60;
      const w = canvas.width;
      const h = canvas.height;

      if (ground) World.remove(world, [ground, leftWall, rightWall]);

      ground = Bodies.rectangle(w / 2, h + thickness / 2, w * 2, thickness, {
        isStatic: true,
        friction: 0.5,
        restitution: 0.2
      });

      leftWall = Bodies.rectangle(-thickness / 2, h / 2, thickness, h * 2, {
        isStatic: true,
        friction: 0.2,
        restitution: 0.4
      });

      rightWall = Bodies.rectangle(w + thickness / 2, h / 2, thickness, h * 2, {
        isStatic: true,
        friction: 0.2,
        restitution: 0.4
      });

      World.add(world, [ground, leftWall, rightWall]);
    }

    // --- Particle Spawn Helper ---
    function createBurst(x, y, color, count = 18) {
      for (let i = 0; i < count; i++) {
        particles.push(new Particle(x, y, color));
      }
    }

    // --- Orb Management ---
    function getRandomSpawnTier() {
      // Allow tiers 0 to 3 for dropping
      return Math.floor(Math.random() * 4);
    }

    function updateNextOrbUI() {
      const info = ORB_TIERS[nextSpawnTier];
      nextOrbContainer.innerHTML = `
        <div class="w-6 h-6 rounded-full" style="background-color: ${info.color}; box-shadow: 0 0 10px ${info.glow}"></div>
      `;
    }

    function createOrbBody(x, y, tier) {
      const info = ORB_TIERS[tier];
      const body = Bodies.circle(x, y, info.radius, {
        restitution: 0.45,
        friction: 0.15,
        density: 0.002,
        label: 'ORB'
      });
      body.orbTier = tier;
      return body;
    }

    function dropCurrentOrb() {
      if (!canDrop || gameState !== 'PLAYING') return;

      sound.init();
      canDrop = false;

      // Ensure aimX stays within bounds
      const currentRadius = ORB_TIERS[currentSpawnTier].radius;
      const clampedX = Math.max(currentRadius + 10, Math.min(canvas.width - currentRadius - 10, aimX));

      const newOrb = createOrbBody(clampedX, 45, currentSpawnTier);
      World.add(world, newOrb);

      sound.playDrop();

      // Cycle next orb
      currentSpawnTier = nextSpawnTier;
      nextSpawnTier = getRandomSpawnTier();
      updateNextOrbUI();

      // Cooldown before next drop allowed
      dropCooldownTimer = setTimeout(() => {
        canDrop = true;
      }, 550);
    }

    // --- Matter.js Collision Handling ---
    function handleCollisions(event) {
      if (gameState !== 'PLAYING') return;

      const pairs = event.pairs;
      const toMerge = [];

      for (let i = 0; i < pairs.length; i++) {
        const { bodyA, bodyB } = pairs[i];

        if (bodyA.label === 'ORB' && bodyB.label === 'ORB') {
          if (bodyA.orbTier === bodyB.orbTier && !bodyA.isMerging && !bodyB.isMerging) {
            // Mark bodies to prevent duplicate merge handling in single frame
            bodyA.isMerging = true;
            bodyB.isMerging = true;
            toMerge.push({ bodyA, bodyB, tier: bodyA.orbTier });
          }
        }
      }

      for (let i = 0; i < toMerge.length; i++) {
        const { bodyA, bodyB, tier } = toMerge[i];

        // Midpoint calculation for new merged orb position
        const midX = (bodyA.position.x + bodyB.position.x) / 2;
        const midY = (bodyA.position.y + bodyB.position.y) / 2;

        World.remove(world, bodyA);
        World.remove(world, bodyB);

        const currentInfo = ORB_TIERS[tier];
        score += currentInfo.score;
        scoreEl.textContent = score;

        createBurst(midX, midY, currentInfo.color, 16);

        // If not max tier, spawn next tier orb
        if (tier + 1 < ORB_TIERS.length) {
          const nextTier = tier + 1;
          const mergedOrb = createOrbBody(midX, midY, nextTier);
          World.add(world, mergedOrb);

          sound.playMerge(nextTier);
        } else {
          // Max tier reached bonus!
          sound.playMerge(ORB_TIERS.length);
          createBurst(midX, midY, '#ffffff', 30);
        }
      }
    }

    // --- Inputs Handling ---
    function handlePointerMove(e) {
      if (gameState !== 'PLAYING') return;
      const rect = canvas.getBoundingClientRect();
      const clientX = e.touches ? e.touches[0].clientX : e.clientX;
      aimX = clientX - rect.left;
    }

    window.addEventListener('mousemove', handlePointerMove);
    window.addEventListener('touchmove', handlePointerMove, { passive: true });

    canvasContainer.addEventListener('pointerdown', (e) => {
      if (gameState === 'PLAYING') {
        handlePointerMove(e);
        dropCurrentOrb();
      }
    });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' || e.key === 'p' || e.key === 'P') {
        if (gameState === 'PLAYING') pauseGame();
        else if (gameState === 'PAUSED') resumeGame();
      }
    });

    // --- Game Logic Controls ---
    function initPhysicsEngine() {
      if (engine) {
        World.clear(world);
        Engine.clear(engine);
      }

      engine = Engine.create({
        gravity: { x: 0, y: 1.2 }
      });

      world = engine.world;
      updateContainerBoundaries();

      Events.on(engine, 'collisionStart', handleCollisions);
    }

    function resetGameData() {
      score = 0;
      scoreEl.textContent = score;
      highScoreEl.textContent = highScore;

      currentSpawnTier = getRandomSpawnTier();
      nextSpawnTier = getRandomSpawnTier();
      updateNextOrbUI();

      canDrop = true;
      dangerTimer = DANGER_LIMIT_TIME;
      isDangerActive = false;
      dangerBanner.classList.add('hidden');

      initPhysicsEngine();
    }

    function startGame() {
      sound.init();
      resetGameData();

      gameState = 'PLAYING';
      startOverlay.classList.add('hidden');
      gameOverOverlay.classList.add('hidden');
      pauseOverlay.classList.add('hidden');

      lastTimestamp = performance.now();
      requestAnimationFrame(gameLoop);
    }

    function pauseGame() {
      if (gameState !== 'PLAYING') return;
      gameState = 'PAUSED';
      pauseOverlay.classList.remove('hidden');
    }

    function resumeGame() {
      if (gameState !== 'PAUSED') return;
      gameState = 'PLAYING';
      pauseOverlay.classList.add('hidden');
      lastTimestamp = performance.now();
      requestAnimationFrame(gameLoop);
    }

    function triggerGameOver() {
      gameState = 'GAMEOVER';
      sound.playGameOver();

      let isNewHigh = false;
      if (score > highScore) {
        highScore = score;
        localStorage.setItem('neon_merge_highscore', highScore);
        highScoreEl.textContent = highScore;
        isNewHigh = true;
      }

      finalScoreEl.textContent = score;
      bestScoreEl.textContent = highScore;

      if (isNewHigh) {
        newHighScoreTag.classList.remove('hidden');
      } else {
        newHighScoreTag.classList.add('hidden');
      }

      dangerBanner.classList.add('hidden');
      gameOverOverlay.classList.remove('hidden');
    }

    // --- Main Game Loop ---
    let lastTimestamp = 0;

    function gameLoop(timestamp) {
      if (gameState !== 'PLAYING') return;

      const dt = Math.min((timestamp - lastTimestamp) / 1000, 0.1);
      lastTimestamp = timestamp;

      // Update Matter.js Engine
      Engine.update(engine, 1000 / 60);

      // Check Danger Overflow Limit
      let isOverflowing = false;
      const bodies = Composite.allBodies(world);

      for (let i = 0; i < bodies.length; i++) {
        const body = bodies[i];
        if (body.label === 'ORB') {
          // Check if top edge of orb is above danger line
          if (body.position.y - body.circleRadius < dangerY && Math.abs(body.velocity.y) < 1.5) {
            isOverflowing = true;
            break;
          }
        }
      }

      if (isOverflowing) {
        dangerTimer -= dt;
        if (dangerTimer <= 0) {
          triggerGameOver();
          return;
        }
        dangerTimerEl.textContent = dangerTimer.toFixed(1);
        dangerBanner.classList.remove('hidden');
      } else {
        dangerTimer = DANGER_LIMIT_TIME;
        dangerBanner.classList.add('hidden');
      }

      // Update Burst Particles
      for (let i = particles.length - 1; i >= 0; i--) {
        particles[i].update();
        if (particles[i].alpha <= 0) {
          particles.splice(i, 1);
        }
      }

      // Render Scene
      render();

      requestAnimationFrame(gameLoop);
    }

    // Shortcut alias for composite lookup
    const { Composite } = Matter;

    function render() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      // 1. Draw Danger Line (Dotted Red Line)
      ctx.save();
      ctx.beginPath();
      ctx.setLineDash([8, 6]);
      ctx.moveTo(0, dangerY);
      ctx.lineTo(canvas.width, dangerY);
      ctx.strokeStyle = '#f43f5e';
      ctx.lineWidth = 2;
      ctx.shadowBlur = 10;
      ctx.shadowColor = '#f43f5e';
      ctx.stroke();
      ctx.restore();

      // 2. Draw Aim Line & Preview Dropping Orb
      if (canDrop) {
        const currentInfo = ORB_TIERS[currentSpawnTier];
        const clampedX = Math.max(currentInfo.radius + 10, Math.min(canvas.width - currentInfo.radius - 10, aimX));

        // Vertical Guide Line
        ctx.save();
        ctx.beginPath();
        ctx.setLineDash([4, 4]);
        ctx.moveTo(clampedX, 45);
        ctx.lineTo(clampedX, canvas.height - 20);
        ctx.strokeStyle = 'rgba(255, 255, 255, 0.2)';
        ctx.lineWidth = 1.5;
        ctx.stroke();
        ctx.restore();

        // Dropping Orb Ghost Preview
        ctx.save();
        ctx.beginPath();
        ctx.arc(clampedX, 45, currentInfo.radius, 0, Math.PI * 2);
        ctx.fillStyle = currentInfo.color;
        ctx.shadowBlur = 15;
        ctx.shadowColor = currentInfo.glow;
        ctx.fill();

        // Subtle Inner Ring Highlight
        ctx.beginPath();
        ctx.arc(clampedX, 45, currentInfo.radius * 0.7, 0, Math.PI * 2);
        ctx.strokeStyle = 'rgba(255, 255, 255, 0.3)';
        ctx.lineWidth = 2;
        ctx.stroke();
        ctx.restore();
      }

      // 3. Draw Physics Bodies (Orbs)
      const bodies = Composite.allBodies(world);

      for (let i = 0; i < bodies.length; i++) {
        const body = bodies[i];
        if (body.label === 'ORB') {
          const info = ORB_TIERS[body.orbTier];

          ctx.save();
          ctx.translate(body.position.x, body.position.y);
          ctx.rotate(body.angle);

          // Glow & Main Circle
          ctx.beginPath();
          ctx.arc(0, 0, info.radius, 0, Math.PI * 2);
          ctx.fillStyle = info.color;
          ctx.shadowBlur = 14;
          ctx.shadowColor = info.glow;
          ctx.fill();

          // Inner Specular Glow
          ctx.beginPath();
          ctx.arc(-info.radius * 0.25, -info.radius * 0.25, info.radius * 0.4, 0, Math.PI * 2);
          ctx.fillStyle = 'rgba(255, 255, 255, 0.35)';
          ctx.fill();

          ctx.restore();
        }
      }

      // 4. Draw Particles
      particles.forEach(p => p.draw(ctx));
    }

    // --- Initial Launch Setup ---
    highScoreEl.textContent = highScore;
    resizeCanvas();
    window.addEventListener('resize', resizeCanvas);

    startBtn.addEventListener('click', startGame);
    restartBtn.addEventListener('click', startGame);
    pauseBtn.addEventListener('click', pauseGame);
    resumeBtn.addEventListener('click', resumeGame);

    quitBtn.addEventListener('click', () => {
      gameState = 'START';
      pauseOverlay.classList.add('hidden');
      startOverlay.classList.remove('hidden');
      if (engine) World.clear(world);
      ctx.clearRect(0, 0, canvas.width, canvas.height);
    });

  </script>
</body>
</html>
